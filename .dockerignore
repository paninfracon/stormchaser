target/
.cargo/
.idea/
.vscode/
**/target/
# After both target/ patterns: the last pattern matching a path decides, and placed
# before `**/target/` this let Docker 29 copy each binary as an empty file
!target/release/stormchaser*
*.png
*.mmd

# Only include the essential Git files required by vergen for tagging
.git/*
!.git/HEAD
!.git/config
!.git/refs/
!.git/objects/
