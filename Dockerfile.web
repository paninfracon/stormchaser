# Multi-stage Dockerfile for stormchaser-web (Leptos)
FROM rust:1.96-slim-bookworm@sha256:e18a79fc84dfcfc3ab5ba72290398a644c135c97eaa881447fddc354ee4701a3 AS builder

# Install build dependencies required for rust and cargo-leptos
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    libgit2-dev \
    zlib1g-dev \
    curl \
    git \
    make \
    && rm -rf /var/lib/apt/lists/*

# Add the WASM target
RUN rustup target add wasm32-unknown-unknown

# Install cargo-leptos
RUN cargo install --locked cargo-leptos

WORKDIR /app

# Copy the entire workspace
COPY . .

# Build the Leptos application
RUN SQLX_OFFLINE=true cargo leptos build --release -p stormchaser-web

# Final runtime image
FROM debian:bookworm-slim@sha256:7c7b2c966bc9ee8cedfeef67e0e279108992c77681fa595db4a9d65c06ccc587

RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy the server binary and the site directory from the builder
COPY --from=builder /app/target/release/stormchaser-web /usr/local/bin/stormchaser-web
COPY --from=builder /app/target/site /app/site

# Set Leptos environment variables
ENV LEPTOS_OUTPUT_NAME="stormchaser-web"
ENV LEPTOS_SITE_ROOT="/app/site"
ENV LEPTOS_SITE_ADDR="0.0.0.0:3000"

# The web tier runs as an unprivileged user
RUN groupadd --system --gid 65532 stormchaser && \
    useradd --system --uid 65532 --gid 65532 --no-create-home --home-dir /nonexistent stormchaser
USER 65532:65532

CMD ["/usr/local/bin/stormchaser-web"]
