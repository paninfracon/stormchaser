{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StepScheduledEvent",
  "type": "object",
  "required": [
    "event_type",
    "run_id",
    "step_dsl",
    "step_id",
    "timestamp"
  ],
  "properties": {
    "event_type": {
      "type": "string"
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "step_dsl": true,
    "step_id": {
      "type": "string",
      "format": "uuid"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  }
}
