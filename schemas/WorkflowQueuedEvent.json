{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WorkflowQueuedEvent",
  "type": "object",
  "required": [
    "event_type",
    "run_id",
    "timestamp"
  ],
  "properties": {
    "dsl": {
      "type": [
        "string",
        "null"
      ]
    },
    "event_type": {
      "type": "string"
    },
    "initiating_user": {
      "type": [
        "string",
        "null"
      ]
    },
    "inputs": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  }
}
