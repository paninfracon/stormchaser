stormchaser_dsl_version = "0.1"

workflow "step_library_demo" {
  description = "A workflow demonstrating the use of step_library for reusable step definitions."

  // Define a reusable step library for a standard python environment
  step_library "python_env" {
    type = "RunContainer"

    // The library's arguments, with their defaults; a step sets the ones it changes
    params {
      python_version = "3.12"
    }

    // Base container specification, which uses the params
    spec {
      image  = "python:${params.python_version}-slim"
      cpu    = "500m"
      memory = "1Gi"
      env = [
        { name = "PYTHONDONTWRITEBYTECODE", value = "1" },
        { name = "PYTHONUNBUFFERED", value = "1" },
      ]
      command = ["python", "-c", "import sys; print('Python', sys.version)"]
    }

    // Default timeout for all steps using this library
    timeout = "10m"
  }

  steps {
    // This step inherits the 'python_env' properties and its default python_version
    step "check" "python_env" {}

    // This step also inherits 'python_env', but overrides the python_version param
    step "check_older" "python_env" {
      params {
        python_version = "3.11"
      }
      next = ["check"] // Run on the older Python, then the newer
    }
  }
}
