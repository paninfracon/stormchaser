workflow "dynamic-query" {
  description = "A test workflow to validate dynamic query capabilities"

  query "env_options" {
    type = "mock"
    params = {
      items = "dev,staging,prod"
    }
  }

  inputs {
    environment = string(enum("${queries.env_options}"))
  }

  steps {
    step "echo-env" "docker" {
      spec {
        image   = "alpine"
        command = ["sh", "-c", "echo 'Deploying to ${inputs.environment}'"]
      }
    }
  }
}
