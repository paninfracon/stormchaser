stormchaser_dsl_version = "v1"

# The "dogfood" workflow is designed to execute using a Stormchaser engine running inside
# Docker Compose. The workflow builds the Stormchaser components from source, creates
# container images using Buildah, and then deploys those images to a target MicroK8s cluster.
#
# IMPORTANT: This workflow inherently requires a target Kubernetes cluster to deploy to.
# Running this workflow without a valid `kubeconfig` or without a running MicroK8s
# cluster will result in failure during the `setup_certs` or `deploy` steps.

workflow "dogfood" {
  description = "Stormchaser dogfooding workflow: Build, Test, Image, Deploy"

  # Connection variables pointing to the target infrastructure (MicroK8s and supporting services)
  input "repo_url" { type = "string" }
  input "host_ip" { type = "string" }
  input "db_password" {
    type   = "string"
    secret = true
  }
  input "kubeconfig" { type = "string" }
  input "port_api" { type = "string" }
  input "port_db" { type = "string" }
  input "port_nats" { type = "string" }
  input "port_loki" { type = "string" }
  input "port_dex" { type = "string" }
  input "port_s3" { type = "string" }
  input "port_reg" { type = "string" }
  input "port_opa" { type = "string" }

  # The main workspace volume shared across steps. It provisions the source code
  # by downloading the repository tarball from MinIO.
  storage "workspace" {
    size = "10Gi"
    provision "repo" {
      resource_type = "download"
      url           = inputs.repo_url
      destination   = "/"
    }
    artifact "api_binary" {
      path      = "target/release/stormchaser-api"
      retention = "7d"
    }
  }

  # A secondary lightweight volume for building the Docker image.
  # We provision the repository again (for Dockerfile) and pull the
  # compiled binary artifact from the build step without copying the whole target dir.
  storage "image_build_context" {
    size = "1Gi"
    provision "repo" {
      resource_type = "download"
      url           = inputs.repo_url
      destination   = "/"
    }
    provision "api_binary" {
      resource_type = "artifact"
      name          = "api_binary"
      destination   = "/target/release/stormchaser-api"
    }
  }

  steps {
    # 1. Build Phase
    # Compiles the Stormchaser API binary from the provisioned source code.
    # This runs in a clean rust:nightly container.
    step "build" "RunContainer" {
      image = "rustlang/rust:nightly"
      storage_mounts = [
        { name = "workspace", mount_path = "/app" }
      ]
      env = [
        { name = "DATABASE_URL", value = "postgres://stormchaser:${inputs.db_password}@${inputs.host_ip}:${inputs.port_db}/stormchaser" }
      ]
      command = ["/bin/sh", "-c"]
      args = [<<-EOF
        set -eo pipefail
        apt-get update >/dev/null 2>&1
        apt-get install -y pkg-config libssl-dev libgit2-dev zlib1g-dev curl >/dev/null 2>&1
        cd /app
        SQLX_OFFLINE=true cargo build --release -p stormchaser-api 2>&1 | tee build.log
      EOF
      ]
      artifacts = ["api_binary"]
      next      = ["test"]
    }

    # 2. Test Phase
    # Runs the Rust test suite to verify the compiled code.
    # Note: `test_enterprise_opa_rbac_integration` is skipped because it requires a
    # running Docker daemon (Docker-in-Docker), which is not available in this container.
    #
    # We use the `preserve` filter here so that when the agent packs the workspace
    # volume at the end of this step, it only keeps the specific files needed for the
    # subsequent steps, discarding the massive intermediate `target/` compilation objects.
    step "test" "RunContainer" {
      image = "rustlang/rust:nightly"
      storage_mounts = [
        {
          name       = "workspace",
          mount_path = "/app",
          preserve   = ["target/release/stormchaser-api", "Dockerfile.prebuilt", "deploy", "tests.xml"]
        }
      ]
      env = [
        { name = "DATABASE_URL", value = "postgres://stormchaser:${inputs.db_password}@${inputs.host_ip}:${inputs.port_db}/stormchaser" },
        { name = "NATS_URL", value = "nats://${inputs.host_ip}:${inputs.port_nats}" }
      ]
      command = ["/bin/sh", "-c"]
      args = [<<-EOF
        set -eo pipefail
        apt-get update >/dev/null 2>&1
        apt-get install -y pkg-config libssl-dev libgit2-dev zlib1g-dev curl >/dev/null 2>&1
        cd /app
        SQLX_OFFLINE=true cargo test --release -p stormchaser-api --jobs 1 -- --test-threads=1 -Z unstable-options --format junit --skip test_enterprise_opa_rbac_integration --skip test_run_from_git > tests.xml
      EOF
      ]
      reports {
        report "api_tests" {
          path   = "/app/tests.xml"
          format = "junit"
        }
      }
      next = ["build_images"]
    }

    # 3. Image Build Phase
    # Uses Buildah to package the compiled binary into a container image.
    # The image is then pushed to the local container registry (exposed on host_ip:port_reg).
    # We remove `.dockerignore` to ensure the `target/release/` dir is included in the build context.
    step "build_images" "RunContainer" {
      image      = "quay.io/buildah/stable:v1.35"
      privileged = true
      storage_mounts = [
        { name = "image_build_context", mount_path = "/app" }
      ]
      command = ["/bin/sh", "-c"]
      args = [<<-EOF
        set -eo pipefail
        cd /app
        rm -f .dockerignore
        buildah bud --storage-driver vfs -t ${inputs.host_ip}:${inputs.port_reg}/stormchaser-api:dogfood -f Dockerfile.prebuilt --build-arg BINARY=stormchaser-api .
        buildah push --storage-driver vfs --tls-verify=false ${inputs.host_ip}:${inputs.port_reg}/stormchaser-api:dogfood
      EOF
      ]
      next = ["setup_certs"]
    }

    # 4. Certificates Setup Phase
    # Connects to the target Kubernetes cluster using the provided kubeconfig.
    # It copies the internal TLS certificates from the Docker environment (which are passed
    # to the runner as part of the K8s manifest) into the new dogfood namespace.
    step "setup_certs" "RunContainer" {
      image = "bitnami/kubectl:latest"
      storage_mounts = [
        { name = "workspace", mount_path = "/app" }
      ]
      env = [
        { name = "KUBECONFIG_DATA", value = inputs.kubeconfig }
      ]
      command = ["/bin/sh", "-c"]
      args = [<<-EOF
        set -eo pipefail
        mkdir -p ~/.kube
        echo "$KUBECONFIG_DATA" > ~/.kube/config
        export KUBECONFIG=~/.kube/config
        kubectl create namespace stormchaser-dogfood --dry-run=client -o yaml | kubectl apply -f -
        kubectl get secret stormchaser-tls-certs -n stormchaser -o yaml \
          | grep -v -E '^( +namespace:| +uid:| +resourceVersion:| +creationTimestamp:)' \
          | kubectl apply -n stormchaser-dogfood -f -
      EOF
      ]
      next = ["deploy"]
    }

    # 5. Deploy Phase
    # Uses Helm to upgrade/install the Stormchaser orchestrator chart into the
    # target Kubernetes cluster, pointing it to the newly built image and the external
    # Docker Compose services for its dependencies.
    step "deploy" "RunContainer" {
      image = "alpine/helm:3.12.0"
      storage_mounts = [
        { name = "workspace", mount_path = "/app" }
      ]
      env = [
        { name = "KUBECONFIG_DATA", value = inputs.kubeconfig }
      ]
      command = ["/bin/sh", "-c"]
      args = [<<-EOF
        set -eo pipefail
        mkdir -p ~/.kube
        echo "$KUBECONFIG_DATA" > ~/.kube/config
        export KUBECONFIG=~/.kube/config

        helm upgrade --install stormchaser-dogfood /app/deploy/charts/stormchaser-orchestration \
          --set global.image.repository=${inputs.host_ip}:${inputs.port_reg}/stormchaser-api \
          --set global.image.tag=dogfood \
          --set global.database.ssl=false \
          --set global.database.url=postgres://stormchaser:${inputs.db_password}@${inputs.host_ip}:${inputs.port_db}/stormchaser \
          --set global.nats.url=nats://${inputs.host_ip}:${inputs.port_nats} \
          --set global.loki.url=http://${inputs.host_ip}:${inputs.port_loki} \
          --set global.opa.url=http://${inputs.host_ip}:${inputs.port_opa}/v1/data/stormchaser/allow \
          --set global.oidc.issuer=http://${inputs.host_ip}:${inputs.port_dex}/dex
      EOF
      ]
    }
  }
}
