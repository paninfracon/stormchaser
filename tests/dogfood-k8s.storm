stormchaser_dsl_version = "v1"

workflow "dogfood" {
  description = "Stormchaser dogfooding workflow (K8s): Build, Test, Image, Deploy"

  # Without quotas a run may use 1 CPU and 4Gi in all, less than the build step asks for
  quotas {
    max_cpu    = "8"
    max_memory = "16Gi"
  }

  inputs {
    type = "object"
    properties {
      repo_url {
        type        = "string"
        description = "URL to the source code tarball"
        format      = "uri"
      }
      kubeconfig {
        type        = "string"
        description = "Kubeconfig YAML content for the target cluster"
      }
      db_password {
        type        = "string"
        description = "Database password"
        secret      = true
        minLength   = 8
      }
      nats_password {
        type        = "string"
        description = "Password of the NATS control-plane user"
        secret      = true
        minLength   = 8
      }
    }
    required = ["repo_url", "kubeconfig", "db_password", "nats_password"]
  }

  storage "workspace" {
    size     = "10Gi"
    preserve = ["/"]
    provision "repo" {
      resource_type = "download"
      url           = inputs.repo_url
      destination   = "/"
    }
    artifact "api_binary" {
      path      = "target/release/stormchaser-api"
      retention = "7d"
    }
  }

  storage "image_build_context" {
    size = "1Gi"
    provision "repo" {
      resource_type = "download"
      url           = inputs.repo_url
      destination   = "/"
    }
    provision "api_binary" {
      resource_type = "artifact"
      name          = "api_binary"
      destination   = "/target/release/stormchaser-api"
    }
  }

  steps {
    step "build" "RunContainer" {
      image = "rustlang/rust:nightly"
      # A release build of the workspace needs more than the default step limits
      # (1 CPU, 2Gi): rustc is OOM-killed at 2Gi
      cpu    = "8"
      memory = "16Gi"
      storage_mounts = [
        { name = "workspace", mount_path = "/app" }
      ]
      env = [
        { name = "DATABASE_URL", value = "postgres://stormchaser:${inputs.db_password}@stormchaser-postgresql.stormchaser.svc.cluster.local:5432/stormchaser" }
      ]
      command = ["/bin/sh", "-c"]
      args = [<<-EOF
        set -eo pipefail
        apt-get update
        apt-get install -y pkg-config libssl-dev libgit2-dev zlib1g-dev curl
        cd /app
        SQLX_OFFLINE=true cargo build --release -p stormchaser-api 2>&1 | tee build.log
      EOF
      ]
      artifacts = ["api_binary"]
      next      = ["test"]
    }

    step "test" "RunContainer" {
      image  = "rustlang/rust:nightly"
      cpu    = "8"
      memory = "16Gi"
      storage_mounts = [
        {
          name       = "workspace",
          mount_path = "/app",
          preserve   = ["target/release/stormchaser-api", "Dockerfile.prebuilt", "deploy"]
        }
      ]
      env = [
        { name = "DATABASE_URL", value = "postgres://stormchaser:${inputs.db_password}@stormchaser-postgresql.stormchaser.svc.cluster.local:5432/stormchaser" },
        { name = "NATS_URL", value = "nats://stormchaser-nats.stormchaser.svc.cluster.local:4222" },
        { name = "NATS_USER", value = "stormchaser" },
        { name = "NATS_PASSWORD", value = inputs.nats_password }
      ]
      command = ["/bin/sh", "-c"]
      args = [<<-EOF
        set -eo pipefail
        apt-get update
        apt-get install -y pkg-config libssl-dev libgit2-dev zlib1g-dev curl
        cd /app
        SQLX_OFFLINE=true cargo test --release -p stormchaser-api --lib -- --test-threads=1 -Z unstable-options --format junit | tee tests.xml
      EOF
      ]
      reports {
        report "api_tests" {
          path   = "/app/tests.xml"
          format = "junit"
        }
      }
      next = ["build_images"]
    }

    step "build_images" "RunContainer" {
      image      = "quay.io/buildah/stable:v1.35"
      privileged = true
      storage_mounts = [
        { name = "image_build_context", mount_path = "/app" }
      ]
      command = ["/bin/sh", "-c"]
      args = [<<-EOF
        set -eo pipefail
        cd /app
        rm -f .dockerignore
        # Dockerfile.prebuilt copies target/sit[e] so that only the web image gets site
        # assets. Docker copies nothing when the pattern matches nothing; buildah fails.
        mkdir -p target/site
        ls -la /app/target/release/ || true
        buildah bud --storage-driver vfs -t registry.container-registry.svc.cluster.local:5000/stormchaser-api:dogfood -f Dockerfile.prebuilt --build-arg BINARY=stormchaser-api .
        buildah push --storage-driver vfs --tls-verify=false registry.container-registry.svc.cluster.local:5000/stormchaser-api:dogfood
      EOF
      ]
      next = ["setup_certs"]
    }

    step "setup_certs" "RunContainer" {
      image = "bitnami/kubectl:latest"
      storage_mounts = [
        { name = "workspace", mount_path = "/app" }
      ]
      env = [
        { name = "KUBECONFIG_DATA", value = inputs.kubeconfig },
        { name = "NATS_PASSWORD", value = inputs.nats_password }
      ]
      command = ["/bin/sh", "-c"]
      args = [<<-EOF
        set -eo pipefail
        umask 077
        mkdir -p ~/.kube
        printf '%b\n' "$KUBECONFIG_DATA" > ~/.kube/config
        export KUBECONFIG=~/.kube/config
        kubectl create namespace stormchaser-dogfood --dry-run=client -o yaml | kubectl apply -f -
        kubectl get secret stormchaser-tls-certs -n stormchaser -o yaml \
          | grep -v -E '^( +namespace:| +uid:| +resourceVersion:| +creationTimestamp:)' \
          | kubectl apply -n stormchaser-dogfood -f -
        kubectl create secret generic stormchaser-nats-control -n stormchaser-dogfood \
          --from-literal=user=stormchaser --from-literal=password="$NATS_PASSWORD" \
          --dry-run=client -o yaml | kubectl apply -f -
      EOF
      ]
      next = ["deploy"]
    }

    step "deploy" "RunContainer" {
      image = "alpine/helm:3.12.0"
      storage_mounts = [
        { name = "workspace", mount_path = "/app" }
      ]
      env = [
        { name = "KUBECONFIG_DATA", value = inputs.kubeconfig },
        # The password reaches the script through the environment: spliced into it, a
        # password with shell syntax in it (the chart default's `<`) breaks the script
        { name = "DB_PASSWORD", value = inputs.db_password }
      ]
      command = ["/bin/sh", "-c"]
      args = [<<-EOF
        set -eo pipefail
        umask 077
        mkdir -p ~/.kube
        printf '%b\n' "$KUBECONFIG_DATA" > ~/.kube/config
        export KUBECONFIG=~/.kube/config

        helm upgrade --install stormchaser-dogfood /app/deploy/charts/stormchaser-orchestration \
          --namespace stormchaser-dogfood \
          --create-namespace \
          --set api.image.repository=localhost:32000/stormchaser-api \
          --set api.image.tag=dogfood \
          --set global.database.ssl=false \
          --set "global.database.url=postgres://stormchaser:$DB_PASSWORD@stormchaser-postgresql.stormchaser.svc.cluster.local:5432/stormchaser" \
          --set global.nats.url=nats://stormchaser-nats.stormchaser.svc.cluster.local:4222 \
          --set global.nats.authSecret=stormchaser-nats-control \
          --set global.loki.url=http://stormchaser-loki.stormchaser.svc.cluster.local:3100 \
          --set global.opa.url=http://stormchaser-stormchaser-orchestration-api.stormchaser.svc.cluster.local:8181/v1/data/stormchaser/allow \
          --set global.oidc.issuer=http://dex.stormchaser.svc.cluster.local:5556/dex
      EOF
      ]
    }
  }
}
