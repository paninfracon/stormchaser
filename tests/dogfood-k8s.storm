stormchaser_dsl_version = "v1"

workflow "dogfood" {
  description = "Stormchaser dogfooding workflow (K8s): Build, Test, Image, Deploy"

  input "repo_url" { type = "string" }
  input "kubeconfig" { type = "string" }
  input "db_password" {
    type   = "string"
    secret = true
  }

  storage "workspace" {
    size     = "10Gi"
    preserve = ["/"]
    provision "repo" {
      resource_type = "download"
      url           = inputs.repo_url
      destination   = "/"
    }
    artifact "api_binary" {
      path      = "target/release/stormchaser-api"
      retention = "7d"
    }
  }

  storage "image_build_context" {
    size = "1Gi"
    provision "repo" {
      resource_type = "download"
      url           = inputs.repo_url
      destination   = "/"
    }
    provision "api_binary" {
      resource_type = "artifact"
      name          = "api_binary"
      destination   = "/target/release/stormchaser-api"
    }
  }

  steps {
    step "build" "RunContainer" {
      image = "rustlang/rust:nightly"
      storage_mounts = [
        { name = "workspace", mount_path = "/app" }
      ]
      env = [
        { name = "DATABASE_URL", value = "postgres://stormchaser:${inputs.db_password}@stormchaser-postgresql.stormchaser.svc.cluster.local:5432/stormchaser" }
      ]
      command = ["/bin/sh", "-c"]
      args = [<<-EOF
        set -eo pipefail
        apt-get update
        apt-get install -y pkg-config libssl-dev libgit2-dev zlib1g-dev curl
        cd /app
        SQLX_OFFLINE=true cargo build --release -p stormchaser-api 2>&1 | tee build.log
      EOF
      ]
      artifacts = ["api_binary"]
      next      = ["test"]
    }

    step "test" "RunContainer" {
      image = "rustlang/rust:nightly"
      storage_mounts = [
        {
          name       = "workspace",
          mount_path = "/app",
          preserve   = ["target/release/stormchaser-api", "Dockerfile.prebuilt", "deploy"]
        }
      ]
      env = [
        { name = "DATABASE_URL", value = "postgres://stormchaser:${inputs.db_password}@stormchaser-postgresql.stormchaser.svc.cluster.local:5432/stormchaser" },
        { name = "NATS_URL", value = "nats://stormchaser-nats.stormchaser.svc.cluster.local:4222" }
      ]
      command = ["/bin/sh", "-c"]
      args = [<<-EOF
        set -eo pipefail
        apt-get update
        apt-get install -y pkg-config libssl-dev libgit2-dev zlib1g-dev curl
        cd /app
        SQLX_OFFLINE=true cargo test --release -p stormchaser-api --lib -- --test-threads=1 -Z unstable-options --format junit | tee tests.xml
      EOF
      ]
      reports {
        report "api_tests" {
          path   = "/app/tests.xml"
          format = "junit"
        }
      }
      next = ["build_images"]
    }

    step "build_images" "RunContainer" {
      image      = "quay.io/buildah/stable:v1.35"
      privileged = true
      storage_mounts = [
        { name = "image_build_context", mount_path = "/app" }
      ]
      command = ["/bin/sh", "-c"]
      args = [<<-EOF
        set -eo pipefail
        cd /app
        rm -f .dockerignore
        ls -la /app/target/release/ || true
        buildah bud --storage-driver vfs -t registry.container-registry.svc.cluster.local:5000/stormchaser-api:dogfood -f Dockerfile.prebuilt --build-arg BINARY=stormchaser-api .
        buildah push --storage-driver vfs --tls-verify=false registry.container-registry.svc.cluster.local:5000/stormchaser-api:dogfood
      EOF
      ]
      next = ["setup_certs"]
    }

    step "setup_certs" "RunContainer" {
      image = "bitnami/kubectl:latest"
      storage_mounts = [
        { name = "workspace", mount_path = "/app" }
      ]
      env = [
        { name = "KUBECONFIG_DATA", value = inputs.kubeconfig }
      ]
      command = ["/bin/sh", "-c"]
      args = [<<-EOF
        set -eo pipefail
        mkdir -p ~/.kube
        printf '%b\n' "$KUBECONFIG_DATA" > ~/.kube/config
        export KUBECONFIG=~/.kube/config
        kubectl create namespace stormchaser-dogfood --dry-run=client -o yaml | kubectl apply -f -
        kubectl get secret stormchaser-tls-certs -n stormchaser -o yaml \
          | grep -v -E '^( +namespace:| +uid:| +resourceVersion:| +creationTimestamp:)' \
          | kubectl apply -n stormchaser-dogfood -f -
      EOF
      ]
      next = ["deploy"]
    }

    step "deploy" "RunContainer" {
      image = "alpine/helm:3.12.0"
      storage_mounts = [
        { name = "workspace", mount_path = "/app" }
      ]
      env = [
        { name = "KUBECONFIG_DATA", value = inputs.kubeconfig }
      ]
      command = ["/bin/sh", "-c"]
      args = [<<-EOF
        set -eo pipefail
        mkdir -p ~/.kube
        printf '%b\n' "$KUBECONFIG_DATA" > ~/.kube/config
        cat ~/.kube/config
        export KUBECONFIG=~/.kube/config

        helm upgrade --install stormchaser-dogfood /app/deploy/charts/stormchaser-orchestration \
          --namespace stormchaser-dogfood \
          --create-namespace \
          --set global.image.repository=localhost:32000/stormchaser-api \
          --set global.image.tag=dogfood \
          --set global.database.ssl=false \
          --set global.database.url=postgres://stormchaser:${inputs.db_password}@stormchaser-postgresql.stormchaser.svc.cluster.local:5432/stormchaser \
          --set global.nats.url=nats://stormchaser-nats.stormchaser.svc.cluster.local:4222 \
          --set global.loki.url=http://stormchaser-loki.stormchaser.svc.cluster.local:3100 \
          --set global.opa.url=http://stormchaser-stormchaser-orchestration-api.stormchaser.svc.cluster.local:8181/v1/data/stormchaser/allow \
          --set global.oidc.issuer=http://dex.stormchaser.svc.cluster.local:5556/dex
      EOF
      ]
    }
  }
}
